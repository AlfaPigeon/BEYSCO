---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'BEYSCO — Precision Integration for the AI Era.', lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <style>
      .orbital-bg {
        background-image:
          radial-gradient(circle at 50% 50%, transparent 0, transparent 49px, #e2e8f0 50px, transparent 51px),
          radial-gradient(circle at 50% 50%, transparent 0, transparent 99px, #e2e8f0 100px, transparent 101px),
          radial-gradient(circle at 50% 50%, transparent 0, transparent 149px, #e2e8f0 150px, transparent 151px),
          radial-gradient(circle at 50% 50%, transparent 0, transparent 199px, #e2e8f0 200px, transparent 201px);
        background-size: 400px 400px;
        background-position: center;
      }
      .ambient-shadow {
        box-shadow: 0 4px 20px rgba(0, 43, 107, 0.04);
      }
      /* Corner-gradient bg used on team hero */
      .bg-orbital {
        background-image: radial-gradient(circle at 100% 0%, rgba(226, 232, 240, 0.4) 0%, transparent 40%),
                          radial-gradient(circle at 0% 100%, rgba(226, 232, 240, 0.4) 0%, transparent 40%);
        background-size: 100% 100%;
      }
      /* Glassmorphism card used on partners page */
      .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 20px rgba(0, 43, 107, 0.04);
      }
      /* Large centered ring pattern used on contact page */
      .orbital-bg-contact {
        background-image:
          radial-gradient(circle at center, transparent 0%, transparent 20%, rgba(226,232,240,0.5) 20.5%, transparent 21%),
          radial-gradient(circle at center, transparent 0%, transparent 40%, rgba(226,232,240,0.4) 40.5%, transparent 41%),
          radial-gradient(circle at center, transparent 0%, transparent 60%, rgba(226,232,240,0.3) 60.5%, transparent 61%);
        background-size: 1000px 1000px;
        background-position: center top -200px;
        background-repeat: no-repeat;
      }
    </style>
  </head>
  <body class="bg-background text-on-background font-body-md text-body-md antialiased selection:bg-secondary-container selection:text-on-secondary-container">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
