---
import { getLangFromUrl, useTranslations, getLocalePath, languages, type Lang } from '../i18n';

const lang = getLangFromUrl(new URL(Astro.request.url));
const t = useTranslations(lang);
const currentPath = new URL(Astro.request.url).pathname;

function switchLang(targetLang: Lang): string {
  const segments = currentPath.split('/').filter(Boolean);
  if (segments[0] in languages) segments[0] = targetLang;
  else segments.unshift(targetLang);
  return '/' + segments.join('/');
}

// matchSegment: '' = active on root/index, null = never active
const currentSegment = currentPath.split('/').filter(Boolean)[1] ?? '';
const serviceSlug = currentPath.split('/').filter(Boolean)[2] ?? '';

const serviceLinks = [
  { key: 'nav.serviceAI' as const, slug: 'ai-intelligent-systems' },
  { key: 'nav.serviceCustom' as const, slug: 'custom-software' },
  { key: 'nav.serviceStrategic' as const, slug: 'strategic-consulting' },
  { key: 'nav.serviceCloud' as const, slug: 'cloud-backend-engineering' },
  { key: 'nav.serviceInteractive' as const, slug: 'interactive-simulation' },
];

const navLinks = [
  { key: 'nav.home' as const, href: '/' + lang + '/', matchSegment: '' as string | null },
  //{ key: 'nav.team' as const, href: getLocalePath(lang, '/team'), matchSegment: 'team' as string | null },
  //{ key: 'nav.partners' as const, href: getLocalePath(lang, '/partners'), matchSegment: 'partners' as string | null },
  { key: 'nav.contact' as const, href: getLocalePath(lang, '/contact'), matchSegment: 'contact' as string | null },
];

const homeLink = navLinks[0];
const contactLink = navLinks[1];
---

<header class="bg-surface/80 backdrop-blur-md top-0 z-50 sticky border-b border-outline-variant/30 shadow-sm transition-all duration-300">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto">
    <!-- Logo -->
    <a href={'/' + lang + '/'} class="font-headline-lg text-headline-lg font-bold tracking-tight text-primary">
      BEYSCO
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex space-x-gutter items-center">
      <a
        href={homeLink.href}
        class={currentSegment === homeLink.matchSegment
          ? 'font-button text-button text-secondary border-b-2 border-secondary pb-1 scale-95 transition-transform ease-out'
          : 'font-button text-button text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-container-low px-2 py-1 rounded'}
      >
        {t(homeLink.key)}
      </a>

      <div class="relative group">
        <a
          href={getLocalePath(lang, '/services/ai-intelligent-systems')}
          class={currentSegment === 'services'
            ? 'font-button text-button text-secondary border-b-2 border-secondary pb-1 scale-95 transition-transform ease-out inline-flex items-center gap-1'
            : 'font-button text-button text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-container-low px-2 py-1 rounded inline-flex items-center gap-1'}
        >
          {t('nav.services')}
          <span class="material-symbols-outlined text-sm">expand_more</span>
        </a>
        <div class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
          <div class="min-w-[320px] rounded-lg border border-outline-variant/40 bg-surface shadow-sm p-2">
            {serviceLinks.map((link) => {
              const href = getLocalePath(lang, `/services/${link.slug}`);
              const isActive = currentSegment === 'services' && serviceSlug === link.slug;

              return (
                <a
                  href={href}
                  class={isActive
                    ? 'block rounded px-3 py-2 font-button text-button text-secondary bg-surface-container-low'
                    : 'block rounded px-3 py-2 font-button text-button text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors'}
                >
                  {t(link.key)}
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <a
        href={contactLink.href}
        class={currentSegment === contactLink.matchSegment
          ? 'font-button text-button text-secondary border-b-2 border-secondary pb-1 scale-95 transition-transform ease-out'
          : 'font-button text-button text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-container-low px-2 py-1 rounded'}
      >
        {t(contactLink.key)}
      </a>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-4">
      <!-- Language switcher -->
      <div class="hidden md:flex items-center gap-1 rounded border border-outline-variant/50 bg-surface-container-low text-xs font-label-sm">
        {Object.keys(languages).map((l) => (
          <a
            href={switchLang(l as Lang)}
            data-lang={l}
            class={`px-2.5 py-1.5 font-label-sm text-label-sm uppercase transition-colors ${lang === l ? 'bg-primary text-on-primary' : 'text-on-surface-variant hover:text-primary'}`}
          >
            {l}
          </a>
        ))}
      </div>

      <!-- CTA button -->
      <div class="hidden md:block">
        <a href={getLocalePath(lang, '/contact')} class="bg-primary hover:bg-primary/90 text-on-primary font-button text-button px-6 py-2 rounded shadow-sm transition-colors duration-200 inline-block">
          {t('nav.getStarted')}
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-btn" class="md:hidden text-primary" aria-label="Toggle menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-outline-variant/30 bg-surface px-margin-mobile pb-4 pt-2 md:hidden">
    <nav class="flex flex-col gap-2">
      <a href={homeLink.href} class="py-2 font-button text-button text-on-surface-variant hover:text-primary transition-colors">
        {t(homeLink.key)}
      </a>

      <p class="pt-2 pb-1 font-label-sm text-label-sm uppercase text-on-surface-variant/80">{t('nav.services')}</p>
      {serviceLinks.map((link) => (
        <a
          href={getLocalePath(lang, `/services/${link.slug}`)}
          class="py-2 pl-3 font-button text-button text-on-surface-variant hover:text-primary transition-colors"
        >
          {t(link.key)}
        </a>
      ))}

      <a href={contactLink.href} class="py-2 font-button text-button text-on-surface-variant hover:text-primary transition-colors">
        {t(contactLink.key)}
      </a>

      <a href={getLocalePath(lang, '/contact')} class="mt-2 bg-primary hover:bg-primary/90 text-on-primary font-button text-button px-6 py-2 rounded shadow-sm transition-colors duration-200 block text-center">
        {t('nav.getStarted')}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  document.querySelectorAll('[data-lang]').forEach((link) => {
    link.addEventListener('click', () => {
      const lang = link.getAttribute('data-lang');
      if (!lang) return;
      document.cookie = `beysco_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
    });
  });
</script>
