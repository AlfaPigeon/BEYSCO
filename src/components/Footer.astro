---
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n';

const lang = getLangFromUrl(new URL(Astro.request.url));
const t = useTranslations(lang);
---

<footer class="bg-tertiary text-tertiary-fixed font-body-md text-body-md border-t border-outline/10 py-section-padding">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Brand -->
    <div class="col-span-1 lg:col-span-1 flex flex-col gap-4">
      <div class="font-headline-lg text-headline-lg font-bold text-surface-container-lowest">BEYSCO</div>
      <p class="text-tertiary-fixed-dim text-sm">Technology Integrator bridging AI and Infrastructure.</p>
    </div>

    <!-- Legal -->
    <div class="col-span-1 flex flex-col gap-4">
      <h4 class="font-label-sm text-label-sm uppercase tracking-widest text-surface-container-lowest/70">{t('footer.legal')}</h4>
      <a href={getLocalePath(lang, '/privacy')} class="font-label-sm text-label-sm text-tertiary-fixed-dim hover:text-secondary-fixed hover:underline transition-all">{t('footer.privacy')}</a>
      <a href={getLocalePath(lang, '/terms')} class="font-label-sm text-label-sm text-tertiary-fixed-dim hover:text-secondary-fixed hover:underline transition-all">{t('footer.terms')}</a>
    </div>

    <!-- Connect -->
    <div class="col-span-1 flex flex-col gap-4">
      <h4 class="font-label-sm text-label-sm uppercase tracking-widest text-surface-container-lowest/70">{t('footer.connect')}</h4>
      {/* <a href="#" class="font-label-sm text-label-sm text-tertiary-fixed-dim hover:text-secondary-fixed hover:underline transition-all smooth-scroll">{t('footer.linkedin')}</a> */}
      <a href="#" class="font-label-sm text-label-sm text-tertiary-fixed-dim hover:text-secondary-fixed hover:underline transition-all smooth-scroll">{t('footer.offices')}</a>
    </div>

    <!-- Copyright -->
    <div class="col-span-1 md:col-span-2 lg:col-span-4 mt-12 pt-8 border-t border-outline/20">
      <p class="font-label-sm text-label-sm text-tertiary-fixed-dim">{t('footer.copy')}</p>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('.smooth-scroll').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
