        <h1 class="font-headline-xl text-headline-xl md:text-[56px] md:leading-[64px] text-primary mb-6">
          {page.title}
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-10 max-w-lg">
          {page.subtitle}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={`/${lang}/contact`} class="bg-primary text-on-primary font-button text-button px-8 py-4 rounded hover:bg-primary/90 transition-colors shadow-sm">
            {page.ctaPrimary}
          </a>
          <a href="#capabilities" class="border border-primary text-primary font-button text-button px-8 py-4 rounded hover:bg-surface-container-low transition-colors">
            {page.ctaSecondary}
          </a>
        </div>
      </div>
      <div class="hidden md:block relative h-[500px] w-full rounded-lg overflow-hidden ambient-shadow border border-outline-variant/30 bg-surface-container-low">
        <img
          src={asset(heroImage.src)}
          alt={heroImage.alt}
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section id="capabilities" class="py-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto bg-surface-container-lowest">
    <div class="mb-16 text-center max-w-3xl mx-auto">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-4">{page.capabilitiesTitle}</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">{page.capabilitiesSub}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {page.capabilities.map((capability) => (
        <div class="bg-surface rounded-lg p-8 ambient-shadow border border-outline-variant/30 hover:border-secondary transition-colors group">
          <div class="mb-6 h-12 w-12 bg-secondary/10 rounded flex items-center justify-center text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors">
            <span class="material-symbols-outlined">{capability.icon}</span>
          </div>
          <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-3">{capability.title}</h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-6">{capability.desc}</p>
          <div class="flex gap-2 mt-auto">
            <span class="font-label-sm text-label-sm bg-secondary-fixed text-on-secondary-fixed-variant px-2 py-1 rounded-sm">{capability.tags[0]}</span>
            <span class="font-label-sm text-label-sm bg-secondary-fixed text-on-secondary-fixed-variant px-2 py-1 rounded-sm">{capability.tags[1]}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-section-padding px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <h2 class="font-headline-lg text-headline-lg text-primary mb-16 text-center">{page.roadmapTitle}</h2>
    <div class="relative">
      <div class="absolute left-[28px] top-10 bottom-10 w-px bg-outline-variant/50 hidden md:block z-0"></div>
      <div class="grid gap-12 relative z-10">
        {page.roadmap.map((step, i) => (
          <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class={`h-14 w-14 rounded-full ${i === 0 ? 'bg-primary text-on-primary' : 'bg-surface-container-high text-primary'} flex items-center justify-center font-headline-lg-mobile text-headline-lg-mobile shrink-0 z-10 border-4 border-background`}>
              {i + 1}
            </div>
            <div class="bg-surface rounded-lg p-8 ambient-shadow border border-outline-variant/30 w-full md:w-[calc(100%-88px)]">
              <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-2">{step.title}</h3>
              <p class="font-body-md text-body-md text-on-surface-variant">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

