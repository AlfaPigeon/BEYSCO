import Layout from '../../../layouts/Layout.astro';
import { type Lang } from '../../../i18n';
import { asset } from '../../../utils';

export const prerender = true;

type ServiceKey = 'ai-intelligent-systems' | 'custom-software' | 'strategic-consulting' | 'cloud-backend-engineering' | 'interactive-simulation';

type ServiceContent = {
  badge: string;
  title: string;
  subtitle: string;
  ctaPrimary: string;
  ctaSecondary: string;
  capabilitiesTitle: string;
  capabilitiesSub: string;
  capabilities: Array<{ title: string; desc: string; tags: [string, string]; icon: string }>;
  roadmapTitle: string;
  roadmap: Array<{ title: string; desc: string }>;
  caseLabel: string;
  caseTitle: string;
  caseDesc: string;
  caseLink: string;
};

export function getStaticPaths() {
  const serviceOrder: ServiceKey[] = [
    'ai-intelligent-systems',
    'custom-software',
    'strategic-consulting',
    'cloud-backend-engineering',
    'interactive-simulation',
  ];

  return (['en', 'tr'] as const).flatMap((lang) =>
    serviceOrder.map((service) => ({ params: { lang, service } })),
  );
}

const { lang, service } = Astro.params as { lang: Lang; service: ServiceKey };

