---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, type Lang } from '../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'tr' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout title="Contact BEYSCO" description={t('contact.heroSub')} lang={lang}>
  <!-- Full-page orbital pattern -->
  <div class="fixed inset-0 pointer-events-none orbital-bg-contact z-0"></div>

  <div class="relative z-10 py-section-padding px-margin-mobile md:px-margin-desktop">
    <div class="max-w-container-max mx-auto">

      <!-- Hero -->
      <header class="text-center mb-[80px] md:mb-section-padding">
        <h1 class="font-headline-xl text-headline-xl text-primary mb-6 tracking-tight">{t('contact.hero')}</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">{t('contact.heroSub')}</p>
      </header>

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">

        <!-- Left Column: Info (5 cols) -->
        <div class="lg:col-span-5 space-y-gutter flex flex-col">

          <!-- Direct Channels Card -->
          <div class="bg-surface-container-lowest rounded shadow-[0_4px_20px_rgba(0,43,107,0.04)] border border-outline-variant/30 p-8 flex-grow">
            <h2 class="font-headline-lg text-headline-lg text-primary mb-8 border-b border-outline-variant/30 pb-4">{t('contact.directChannels')}</h2>
            <div class="space-y-6">

              <div class="flex items-start space-x-4 group cursor-pointer">
                <div class="w-12 h-12 rounded bg-surface flex items-center justify-center text-secondary group-hover:bg-secondary-container group-hover:text-on-secondary-container transition-colors border border-outline-variant/30">
                  <span class="material-symbols-outlined">mail</span>
                </div>
                <div>
                  <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">{t('contact.emailLabel')}</h3>
                  <p class="font-body-md text-body-md text-primary font-medium group-hover:text-secondary transition-colors">{t('contact.email')}</p>
                </div>
              </div>

              {/* <div class="flex items-start space-x-4 group cursor-pointer">
                <div class="w-12 h-12 rounded bg-surface flex items-center justify-center text-secondary group-hover:bg-secondary-container group-hover:text-on-secondary-container transition-colors border border-outline-variant/30">
                  <span class="material-symbols-outlined">call</span>
                </div>
                <div>
                  <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">{t('contact.phoneLabel')}</h3>
                  <p class="font-body-md text-body-md text-primary font-medium group-hover:text-secondary transition-colors">{t('contact.phone')}</p>
                </div>
              </div> */}

              {/* <div class="flex items-start space-x-4 group cursor-pointer">
                <div class="w-12 h-12 rounded bg-surface flex items-center justify-center text-secondary group-hover:bg-secondary-container group-hover:text-on-secondary-container transition-colors border border-outline-variant/30">
                  <span class="material-symbols-outlined">public</span>
                </div>
                <div>
                  <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">{t('contact.linkedinLabel')}</h3>
                  <p class="font-body-md text-body-md text-primary font-medium flex items-center group-hover:text-secondary transition-colors">
                    LinkedIn <span class="material-symbols-outlined text-sm ml-1">arrow_outward</span>
                  </p>
                </div>
              </div> */}

            </div>
          </div>

          <!-- Global Presence Card -->
          <div class="bg-surface-container-lowest rounded shadow-[0_4px_20px_rgba(0,43,107,0.04)] border border-outline-variant/30 p-8 flex-grow">
            <div class="flex justify-between items-center mb-6 border-b border-outline-variant/30 pb-4">
              <h2 class="font-headline-lg text-headline-lg text-primary">{t('contact.globalPresence')}</h2>
              <span class="inline-flex items-center px-2 py-1 rounded bg-secondary-container text-on-secondary-container font-label-sm text-label-sm uppercase">{t('contact.offices')}</span>
            </div>
            <div class="grid grid-cols-1 gap-6 mb-6">
              <div class="p-4 border border-outline-variant/20 rounded hover:border-secondary/50 transition-colors bg-surface flex items-start gap-4">
                <span class="material-symbols-outlined text-secondary mt-0.5" style="font-variation-settings:'FILL' 1">location_city</span>
                <div>
                  <h4 class="font-body-md text-body-md font-medium text-primary">İstanbul</h4>
                  <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 leading-relaxed">
                    Esentepe Mah. Büyükdere Cad. Büyükdere Plaza No: 195 İç Kapı No: 5 Şişli / İstanbul
                  </p>
                </div>
              </div>
            </div>
            <!-- Google Maps embed — Büyükdere Plaza, Şişli/İstanbul -->
            <div class="w-full h-64 rounded border border-outline-variant/30 overflow-hidden relative">
              <iframe
                title="BEYSCO Office - İstanbul"
                src="https://maps.google.com/maps?q=B%C3%BCy%C3%BCkdere+Plaza+B%C3%BCy%C3%BCkdere+Cad+No+195+%C5%9Ei%C5%9Fli+%C4%B0stanbul&t=&z=16&ie=UTF8&iwloc=&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="w-full h-full grayscale hover:grayscale-0 transition-all duration-500"
                style="border:0;"
                allowfullscreen
              ></iframe>
            </div>
          </div>

        </div>

        <!-- Right Column: Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="bg-surface-container-lowest rounded shadow-[0_4px_20px_rgba(0,43,107,0.04)] border border-outline-variant/30 p-8 md:p-12 h-full">
            <div class="mb-10">
              <span class="inline-flex items-center px-2 py-1 rounded bg-surface text-primary border border-outline-variant/50 font-label-sm text-label-sm uppercase mb-4">{t('contact.formBadge')}</span>
              <h2 class="font-headline-lg text-headline-lg text-primary mb-2">{t('contact.formTitle')}</h2>
              <p class="font-body-md text-body-md text-on-surface-variant">{t('contact.formDesc')}</p>
            </div>

            <form class="space-y-6" method="POST" action="#">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase" for="fullName">{t('contact.nameLabel')}</label>
                  <input
                    class="w-full bg-surface-container-lowest border border-outline-variant rounded focus:border-secondary focus:ring-2 focus:ring-secondary/10 outline-none px-4 py-3 font-body-md text-body-md text-on-surface transition-all placeholder:text-outline-variant/70"
                    id="fullName" name="fullName" type="text"
                    placeholder={t('contact.namePlaceholder')}
                  />
                </div>
                <div>
                  <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase" for="company">{t('contact.companyLabel')}</label>
                  <input
                    class="w-full bg-surface-container-lowest border border-outline-variant rounded focus:border-secondary focus:ring-2 focus:ring-secondary/10 outline-none px-4 py-3 font-body-md text-body-md text-on-surface transition-all placeholder:text-outline-variant/70"
                    id="company" name="company" type="text"
                    placeholder={t('contact.companyPlaceholder')}
                  />
                </div>
              </div>

              <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase" for="workEmail">{t('contact.emailFormLabel')}</label>
                <input
                  class="w-full bg-surface-container-lowest border border-outline-variant rounded focus:border-secondary focus:ring-2 focus:ring-secondary/10 outline-none px-4 py-3 font-body-md text-body-md text-on-surface transition-all placeholder:text-outline-variant/70"
                  id="workEmail" name="workEmail" type="email"
                  placeholder={t('contact.emailFormPlaceholder')}
                />
              </div>

              <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase" for="serviceInterest">{t('contact.serviceLabel')}</label>
                <div class="relative">
                  <select
                    class="w-full appearance-none bg-surface-container-lowest border border-outline-variant rounded focus:border-secondary focus:ring-2 focus:ring-secondary/10 outline-none px-4 py-3 pr-10 font-body-md text-body-md text-on-surface transition-all cursor-pointer"
                    id="serviceInterest" name="serviceInterest"
                  >
                    <option disabled selected value="">{t('contact.serviceDefault')}</option>
                    <option value="ai-integration">{t('contact.serviceAI')}</option>
                    <option value="cloud-infrastructure">{t('contact.serviceCloud')}</option>
                    <option value="data-engineering">{t('contact.serviceData')}</option>
                    <option value="security-compliance">{t('contact.serviceSecurity')}</option>
                    <option value="other">{t('contact.serviceOther')}</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-outline-variant">
                    <span class="material-symbols-outlined">expand_more</span>
                  </div>
                </div>
              </div>

              <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant mb-2 uppercase" for="projectDetails">{t('contact.projectLabel')}</label>
                <textarea
                  class="w-full bg-surface-container-lowest border border-outline-variant rounded focus:border-secondary focus:ring-2 focus:ring-secondary/10 outline-none px-4 py-3 font-body-md text-body-md text-on-surface transition-all placeholder:text-outline-variant/70 resize-y"
                  id="projectDetails" name="projectDetails" rows="5"
                  placeholder={t('contact.projectPlaceholder')}
                ></textarea>
              </div>

              <div class="pt-4 border-t border-outline-variant/30 flex justify-end">
                <button
                  type="submit"
                  class="bg-primary text-on-primary font-button text-button px-8 py-3.5 rounded hover:bg-primary-container transition-colors shadow-sm flex items-center space-x-2"
                >
                  <span>{t('contact.submit')}</span>
                  <span class="material-symbols-outlined text-sm">send</span>
                </button>
              </div>

              <p class="text-center font-label-sm text-label-sm text-outline mt-4">
                {t('contact.privacyText')} <a class="text-secondary hover:underline" href="privacy">{t('contact.privacyLink')}</a> {t('contact.privacySuffix')}
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>
