---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalePath } from '../i18n';
import { asset } from '../utils';

export const prerender = true;

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`BEYSCO Technology Integrator`} description={t('services.heroSub')} lang={lang}>
  <script is:inline>
    (() => {
      const hasLanguageCookie = document.cookie
        .split(';')
        .map((c) => c.trim())
        .some((c) => c.startsWith('beysco_lang=') || c.startsWith('lang=') || c.startsWith('locale=') || c.startsWith('language='));

      const browserIsTurkish = (navigator.language || '').toLowerCase().startsWith('tr');

      if (!hasLanguageCookie && browserIsTurkish && window.location.pathname === '/') {
        window.location.replace('/tr/');
      }
    })();
  </script>

  <!-- Hero Section -->
  <section class="relative pt-section-padding pb-section-padding px-margin-mobile md:px-margin-desktop overflow-hidden">
    <div class="absolute inset-0 orbital-bg opacity-30 pointer-events-none z-0"></div>
    <div class="max-w-container-max mx-auto relative z-10 text-center">

      <h1 class="font-headline-xl text-headline-xl text-primary mb-6 max-w-4xl mx-auto">
        {t('services.hero')}
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto mb-10">
        {t('services.heroSub')}
      </p>
      <a href={getLocalePath(lang, '/contact')} class="bg-primary hover:bg-primary/90 text-on-primary font-button text-button px-8 py-4 rounded shadow-sm transition-colors duration-200 inline-flex items-center justify-center space-x-2">
        <span>{t('services.cta')}</span>
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>
  </section>

  <!-- Services Bento Grid -->
  <section class="py-section-padding px-margin-mobile md:px-margin-desktop bg-surface-container-low">
    <div class="max-w-container-max mx-auto">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-12 text-center">
        {t('services.coreComp')}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-base auto-rows-[minmax(300px,auto)]">

        <!-- AI Integration (Large) -->
        <div class="md:col-span-8 bg-surface-container-lowest rounded-lg p-8 ambient-shadow border border-outline-variant/30 flex flex-col justify-between group overflow-hidden relative">
          <div class="absolute -right-10 -top-10 opacity-5 transition-transform duration-500 group-hover:scale-110">
            <span class="material-symbols-outlined text-[200px]">psychology</span>
          </div>
          <div class="relative z-10">
            <div class="inline-block bg-inverse-primary text-on-primary-fixed-variant font-label-sm text-label-sm px-2 py-1 mb-6 uppercase rounded-sm">AI</div>
            <h3 class="font-headline-lg text-headline-lg text-primary mb-4">{t('services.aiTitle')}</h3>
            <p class="text-on-surface-variant max-w-xl mb-6">{t('services.aiDesc')}</p>
          </div>
        </div>

        <!-- Cloud Infrastructure (Small) -->
        <div class="md:col-span-4 bg-surface-container-lowest rounded-lg p-8 ambient-shadow border border-outline-variant/30 flex flex-col justify-between">
          <div>
            <div class="inline-block bg-inverse-primary text-on-primary-fixed-variant font-label-sm text-label-sm px-2 py-1 mb-6 uppercase rounded-sm">CloudOps</div>
            <span class="material-symbols-outlined text-4xl text-primary mb-4 block">cloud_sync</span>
            <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-4">{t('services.cloudTitle')}</h3>
            <p class="text-on-surface-variant text-sm">{t('services.cloudDesc')}</p>
          </div>
        </div>

        <!-- Enterprise Security (Small) -->
        <div class="md:col-span-4 bg-surface-container-lowest rounded-lg p-8 ambient-shadow border border-outline-variant/30 flex flex-col justify-between">
          <div>
            <div class="inline-block bg-inverse-primary text-on-primary-fixed-variant font-label-sm text-label-sm px-2 py-1 mb-6 uppercase rounded-sm">SecOps</div>
            <span class="material-symbols-outlined text-4xl text-primary mb-4 block">shield_lock</span>
            <h3 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-4">{t('services.secTitle')}</h3>
            <p class="text-on-surface-variant text-sm">{t('services.secDesc')}</p>
          </div>
        </div>

        <!-- Strategic Consulting (Large) -->
        <div class="md:col-span-8 bg-surface-container-lowest rounded-lg p-8 ambient-shadow border border-outline-variant/30 flex flex-col md:flex-row gap-8 items-center justify-between">
          <div class="flex-1">
            <div class="inline-block bg-inverse-primary text-on-primary-fixed-variant font-label-sm text-label-sm px-2 py-1 mb-6 uppercase rounded-sm">Strategy</div>
            <h3 class="font-headline-lg text-headline-lg text-primary mb-4">{t('services.stratTitle')}</h3>
            <p class="text-on-surface-variant mb-6">{t('services.stratDesc')}</p>
          </div>
          <div class="w-full md:w-1/3 aspect-square rounded-sm overflow-hidden border border-outline-variant/50">
            <img
              alt="Consulting Strategy"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
              src={asset(`/images/consulting-strategy.jpg`)}
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-section-padding px-margin-mobile md:px-margin-desktop bg-surface-container-lowest relative overflow-hidden">
    <div class="absolute inset-0 orbital-bg opacity-20 pointer-events-none z-0"></div>
    <div class="max-w-container-max mx-auto relative z-10">
      <div class="text-center mb-16">
        <h2 class="font-headline-xl text-headline-xl text-primary mb-4">{t('services.methodology')}</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">{t('services.methodSub')}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter relative">
        <!-- Connector line (desktop) -->
        <div class="hidden md:block absolute top-12 left-[12.5%] right-[12.5%] h-px bg-outline-variant/50 z-0"></div>

        <!-- Step 1 -->
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full bg-surface-container-lowest border-4 border-surface-container-low flex items-center justify-center mb-6 shadow-sm">
            <span class="material-symbols-outlined text-4xl text-secondary">travel_explore</span>
          </div>
          <h4 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-2">{t('services.step1Title')}</h4>
          <p class="text-on-surface-variant text-sm px-4">{t('services.step1Desc')}</p>
        </div>

        <!-- Step 2 -->
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full bg-surface-container-lowest border-4 border-surface-container-low flex items-center justify-center mb-6 shadow-sm">
            <span class="material-symbols-outlined text-4xl text-secondary">architecture</span>
          </div>
          <h4 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-2">{t('services.step2Title')}</h4>
          <p class="text-on-surface-variant text-sm px-4">{t('services.step2Desc')}</p>
        </div>

        <!-- Step 3 -->
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full bg-surface-container-lowest border-4 border-surface-container-low flex items-center justify-center mb-6 shadow-sm">
            <span class="material-symbols-outlined text-4xl text-secondary">settings_b_roll</span>
          </div>
          <h4 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-2">{t('services.step3Title')}</h4>
          <p class="text-on-surface-variant text-sm px-4">{t('services.step3Desc')}</p>
        </div>

        <!-- Step 4 -->
        <div class="relative z-10 flex flex-col items-center text-center">
          <div class="w-24 h-24 rounded-full bg-surface-container-lowest border-4 border-surface-container-low flex items-center justify-center mb-6 shadow-sm">
            <span class="material-symbols-outlined text-4xl text-secondary">monitoring</span>
          </div>
          <h4 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-2">{t('services.step4Title')}</h4>
          <p class="text-on-surface-variant text-sm px-4">{t('services.step4Desc')}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
